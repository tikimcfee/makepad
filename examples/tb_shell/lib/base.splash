    padding: Inset{left: 14 right: 14} align: Align{y: 0.5}
    show_bg: true
    draw_bg.color: #x18202e draw_bg.border_radius: 14.0
}
let Dot = RoundedView{width: 12 height: 12 show_bg: true draw_bg.border_radius: 6.0 draw_bg.color: #x666666}
let Title = Label{text: "" draw_text.text_style.font_size: 17.5 draw_text.color: #xeeeeee}
let Small = Label{text: "" draw_text.text_style.font_size: 13 draw_text.color: #x9aa4b2}
let Big = ButtonFlat{width: Fill height: 64 text: "" margin: 0}
let PillBtn = ButtonFlat{
    width: Fit height: 36 text: "" margin: 0
    padding: Inset{left: 12 right: 12 top: 0 bottom: 0}
    draw_bg.color: #x222c3e draw_bg.color_focus: #x222c3e draw_bg.color_hover: #x2c3950
    draw_text.text_style.font_size: 13
}
let MiniBtn = ButtonFlat{
    width: 38 height: 36 text: "" margin: 0
    padding: 0
    draw_bg.color: #x222c3e draw_bg.color_focus: #x222c3e draw_bg.color_hover: #x2c3950
    draw_text.text_style.font_size: 14
}
fn status_color(s) {
    if s == "waiting" { return #xa855f7 }
    if s == "busy" || s == "processing" { return #xf5b942 }
    if s == "idle" || s == "online" { return #x3ddc84 }
    if s == "error" || s == "failed" { return #xff5a5a }
    #x666666
}
fn bus_term_id(id) {
    if id == nil || id == "" { return "" }
    let parts = ("" + id).split("@")
    if parts.len() > 1 && parts[1] != "" {
        return "bus-" + parts[0] + "--" + parts[1]
    }
    "bus-" + parts[0]
}
fn show(v, unit) { if v == nil { return "-" } "" + v + unit }
fn agent_name(list, id) {
    for a in list ?? [] { if a.id == id { return a.name } }
    if id == nil { return "none" }
    id
}
fn agent_host(id) {
    if id == nil { return "" }
    let parts = ("" + id).split("@")
    if parts.len() > 1 { return "@" + parts[1] }
    ""
}
fn sa_val(v) {
    if v == nil { return 0.0 }
    let f = v * 1.0
    if f < 0.0 { return 0.0 }
    f
}
fn sa_left() {
    if state.safe_area_off ?? false { return 0.0 }
    let sa = state.safe_area ?? nil
    if sa == nil { return 0.0 }
    sa_val(sa.left ?? nil)
}
fn sa_right() {
    if state.safe_area_off ?? false { return 0.0 }
    let sa = state.safe_area ?? nil
    if sa == nil { return 0.0 }
    sa_val(sa.right ?? nil)
}
fn sa_bottom() {
    if state.safe_area_off ?? false { return 0.0 }
    let sa = state.safe_area ?? nil
    if sa == nil { return 0.0 }
    sa_val(sa.bottom ?? nil)
}
fn sa_pad(base, inset) {
    if inset > base { return inset }
    base
}
fn sa_inner(base, inset) {
    if base > inset { return base - inset }
    0.0
}
// A floating layer's card (`stage float`): frosted glass over whatever the stage shows
// underneath, sampled only inside the card. The navy tint keeps 15 px text legible over
// Chat; `fallback_color` is the whole look under MAKEPAD_NO_GAUSS=1 (and before the first
// capture), so it must read well on its own. A visible radius of 22 is corner_radius 11.
let GlassCard = GaussRoundedView{
    width: Fill height: Fit flow: Down
    padding: 12 spacing: 8
    draw_bg.corner_radius: 11.0
    draw_bg.blur_level: 3.5
    draw_bg.edge_blur_level: 3.5
    draw_bg.lensing_effect: 0.0
    draw_bg.lensing_strength: 0.0
    draw_bg.lensing_width: 0.0
    draw_bg.tint_color: #x0d1626
    draw_bg.tint_alpha: 0.5
    draw_bg.rim_alpha: 0.12
    draw_bg.border_color: #xffffff
    draw_bg.border_alpha: 0.08
    draw_bg.border_width: 0.5
    draw_bg.inner_shadow_alpha: 0.0
    draw_bg.fallback_color: #x0d1626
    draw_bg.shadow_color: #x00000055
}
