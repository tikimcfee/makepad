fn status_color(s) {
    if s == "busy" { return #xf5b942 }
    if s == "idle" { return #x3ddc84 }
    if s == "error" { return #xff5a5a }
    #x666666
}
fn show(v, unit) { if v == nil { return "-" } "" + v + unit }
