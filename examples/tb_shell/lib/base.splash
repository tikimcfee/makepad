let Squircle = RoundedView{
    width: Fill height: 72 flow: Right spacing: 14
    padding: Inset{left: 18 right: 18} align: Align{y: 0.5}
    new_batch: true show_bg: true
    draw_bg.color: #x1c2230 draw_bg.border_radius: 22.0
}
let Dot = RoundedView{width: 16 height: 16 show_bg: true draw_bg.border_radius: 8.0 draw_bg.color: #x666666}
let Title = Label{text: "" draw_text.text_style.font_size: 18 draw_text.color: #xeeeeee}
let Small = Label{text: "" draw_text.text_style.font_size: 13 draw_text.color: #x9aa4b2}
