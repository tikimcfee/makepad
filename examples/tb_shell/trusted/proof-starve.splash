// The starve proof's body: every callback burns its 200,000 instructions, a timer
// does it 60 times a second, and a full-window shader with a 48-step loop redraws
// every frame. For the starve proof only.
let mut spin = 0
fn burn() { loop { spin = spin + 1 } }
mod.std.start_interval(0.016, || { burn() })
width: Fill height: Fill
main := View{
    width: Fill height: Fill show_bg: true
    draw_bg +: {
        pixel: fn() {
            let t = self.draw_pass.time
            let mut acc = 0.0
            for i in 0..48 {
                let fi = float(i)
                acc = acc + sin(self.pos.x * 37.0 + fi * 1.7 + t) * cos(self.pos.y * 29.0 - fi * 0.9 + t * 1.3)
            }
            let v = 0.5 + 0.5 * sin(acc)
            return vec4(v * 0.3, v * 0.1, v * 0.4, 1.0)
        }
    }
    on_render: || { burn() }
}
