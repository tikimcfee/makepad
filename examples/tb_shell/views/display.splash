// DISPLAY: backlight presets (`1..255`), `screen-timeout` (`30s/60s/2m/5m/Never`),
// `/run/tinybot/display-state` path/fallback, and `Sleep now`.
let Cell = Squircle{
    width: Fill height: 78 flow: Down spacing: 3
    padding: Inset{left: 14 right: 14} align: Align{x: 0.0 y: 0.5}
    draw_bg.border_radius: 16.0
    k := Small{}
    v := Title{draw_text.text_style.font_size: 20}
}
let Preset = ButtonFlat{
    width: Fill height: 48 text: "" margin: 0
    draw_text.text_style.font_size: 14.5
}
fn pick_bg(on) { if on { return #x284772 } #x1c2230 }
width: Fill height: Fit flow: Down
main := View{
    width: Fill height: Fit flow: Down
    on_render: || {
        let smode = slot.mode ?? "full"
        let is_compact = smode == "compact"
        let is_grid = smode == "grid"
        let d = state.display ?? nil
        let cur = if d == nil { nil } else { d.brightness ?? nil }
        let max = if d == nil { 255 } else { d.max ?? 255 }
        let panel = if d == nil { nil } else { d.panel ?? nil }
        let path = if d == nil { nil } else { d.path ?? nil }
        let fb = if d == nil { false } else { d.fallback ?? false }
        let tmo = if d == nil { 60 } else { d.timeout ?? 60 }
        let last = if d == nil { "" } else { d.last ?? "" }

        if is_compact {
            View{
                width: Fill height: Fit padding: Inset{left: 10 right: 10 top: 6 bottom: 6}
                CompactBar{
                    Title{width: Fill draw_text.text_style.font_size: 15 text: "Bri " + show(cur, "") + "/" + show(max, "")}
                    MiniBtn{text: "-" on_click: || emit("step", {delta: -1})}
                    MiniBtn{text: "+" on_click: || emit("step", {delta: 1})}
                    PillBtn{height: 36 text: "Sleep" on_click: || emit("sleep", {})}
                }
            }
        } else if is_grid {
            View{
                width: Fill height: Fit flow: Down padding: 10 spacing: 7
                View{
                    width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    Title{width: Fill draw_text.text_style.font_size: 15 text: "Display"}
                    Small{text: show(panel, "")}
                }
                Cell{height: Fit padding: Inset{left: 10 right: 10 top: 6 bottom: 6} k.text: "brightness" v.draw_text.text_style.font_size: 15 v.text: if cur == nil { "-" } else { show(cur, "") + " / " + show(max, "") }}
                View{width: Fill height: Fit flow: Right spacing: 5
                    Preset{height: 38 text: "25" draw_bg.color: pick_bg(cur == 25) draw_bg.color_focus: pick_bg(cur == 25) draw_bg.color_hover: pick_bg(cur == 25) on_click: || emit("set", {level: 25})}
                    Preset{height: 38 text: "128" draw_bg.color: pick_bg(cur == 128) draw_bg.color_focus: pick_bg(cur == 128) draw_bg.color_hover: pick_bg(cur == 128) on_click: || emit("set", {level: 128})}
                    Preset{height: 38 text: "255" draw_bg.color: pick_bg(cur == 255) draw_bg.color_focus: pick_bg(cur == 255) draw_bg.color_hover: pick_bg(cur == 255) on_click: || emit("set", {level: 255})}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    Preset{height: 38 text: "- step" on_click: || emit("step", {delta: -1})}
                    Preset{height: 38 text: "+ step" on_click: || emit("step", {delta: 1})}
                }
                Big{height: 40 text: "Sleep" draw_bg.color: #x212c40 draw_bg.color_focus: #x212c40 draw_bg.color_hover: #x2c3b54 on_click: || emit("sleep", {})}
            }
        } else {
            let sc_h = ((slot.height ?? 780.0) - 20.0)
            let safe_h = if sc_h < 140.0 { 140.0 } else { sc_h }
            ScrollYView{
                width: Fill height: safe_h flow: Down padding: 14 spacing: 9
                Small{text: "Display backlight (1.." + show(max, ")") + (if path == nil { "" } else { "  ·  path: " + path })}
                if fb {
                    Small{width: Fill text: "Fallback display path active" draw_text.color: #xf5b942}
                }
                View{width: Fill height: Fit flow: Right spacing: 9
                    Cell{k.text: "brightness" v.text: if cur == nil { "-" } else { show(cur, "") + " / " + show(max, "") }}
                    Cell{k.text: "panel" v.text: show(panel, "")}
                }
                View{width: Fill height: Fit flow: Right spacing: 7
                    Preset{text: "5" draw_bg.color: pick_bg(cur == 5) draw_bg.color_focus: pick_bg(cur == 5) draw_bg.color_hover: pick_bg(cur == 5) on_click: || emit("set", {level: 5})}
                    Preset{text: "25" draw_bg.color: pick_bg(cur == 25) draw_bg.color_focus: pick_bg(cur == 25) draw_bg.color_hover: pick_bg(cur == 25) on_click: || emit("set", {level: 25})}
                    Preset{text: "64" draw_bg.color: pick_bg(cur == 64) draw_bg.color_focus: pick_bg(cur == 64) draw_bg.color_hover: pick_bg(cur == 64) on_click: || emit("set", {level: 64})}
                }
                View{width: Fill height: Fit flow: Right spacing: 7
                    Preset{text: "128" draw_bg.color: pick_bg(cur == 128) draw_bg.color_focus: pick_bg(cur == 128) draw_bg.color_hover: pick_bg(cur == 128) on_click: || emit("set", {level: 128})}
                    Preset{text: "199" draw_bg.color: pick_bg(cur == 199) draw_bg.color_focus: pick_bg(cur == 199) draw_bg.color_hover: pick_bg(cur == 199) on_click: || emit("set", {level: 199})}
                    Preset{text: "255" draw_bg.color: pick_bg(cur == 255) draw_bg.color_focus: pick_bg(cur == 255) draw_bg.color_hover: pick_bg(cur == 255) on_click: || emit("set", {level: 255})}
                }
                View{width: Fill height: Fit flow: Right spacing: 7
                    Preset{text: "- step" on_click: || emit("step", {delta: -1})}
                    Preset{text: "+ step" on_click: || emit("step", {delta: 1})}
                }
                Small{text: "Idle timeout"}
                View{width: Fill height: Fit flow: Right spacing: 6
                    Preset{height: 44 text: "30s" draw_bg.color: pick_bg(tmo == 30) draw_bg.color_focus: pick_bg(tmo == 30) draw_bg.color_hover: pick_bg(tmo == 30) on_click: || emit("timeout", {secs: 30})}
                    Preset{height: 44 text: "60s" draw_bg.color: pick_bg(tmo == 60) draw_bg.color_focus: pick_bg(tmo == 60) draw_bg.color_hover: pick_bg(tmo == 60) on_click: || emit("timeout", {secs: 60})}
                    Preset{height: 44 text: "2m" draw_bg.color: pick_bg(tmo == 120) draw_bg.color_focus: pick_bg(tmo == 120) draw_bg.color_hover: pick_bg(tmo == 120) on_click: || emit("timeout", {secs: 120})}
                    Preset{height: 44 text: "5m" draw_bg.color: pick_bg(tmo == 300) draw_bg.color_focus: pick_bg(tmo == 300) draw_bg.color_hover: pick_bg(tmo == 300) on_click: || emit("timeout", {secs: 300})}
                    Preset{height: 44 text: "Never" draw_bg.color: pick_bg(tmo == 0) draw_bg.color_focus: pick_bg(tmo == 0) draw_bg.color_hover: pick_bg(tmo == 0) on_click: || emit("timeout", {secs: 0})}
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    Big{height: 48 text: "Sleep now" draw_bg.color: #x212c40 draw_bg.color_focus: #x212c40 draw_bg.color_hover: #x2c3b54 on_click: || emit("sleep", {})}
                    Big{height: 48 text: "Refresh" on_click: || emit("refresh", {})}
                }
                if last != "" {
                    Small{width: Fill text: last}
                }
            }
        }
    }
}
