// CHAT: conversation view for the selected agent (state.chat).
let MsgCard = RoundedView{
    width: Fill height: Fit flow: Down spacing: 4
    padding: Inset{top: 10 bottom: 10 left: 14 right: 14}
    new_batch: true show_bg: true
    draw_bg.color: #x1c2230 draw_bg.border_radius: 16.0
    who := Small{}
    body := Label{width: Fill text: "" draw_text.text_style.font_size: 16 draw_text.color: #xeeeeee}
}
width: Fill height: Fill flow: Down padding: 14 spacing: 10
main := View{
    width: Fill height: Fill flow: Down spacing: 10
    on_render: || {
        let c = state.chat ?? nil
        let target_name = agent_name(state.agents ?? nil, state.target ?? nil)
        let st = if c == nil { "" } else { c.status ?? "" }
        let act = if c == nil { "" } else { c.activity ?? "" }
        let msgs = if c == nil { [] } else { c.msgs ?? [] }
        View{
            width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
            Dot{draw_bg.color: status_color(st)}
            Title{width: Fill text: if c == nil { target_name } else { c.agent ?? target_name }}
            Small{text: st}
        }
        if msgs.len() == 0 {
            View{
                width: Fill height: Fill flow: Down align: Align{y: 0.5}
                Small{width: Fill text: "No messages yet."}
            }
        } else {
            feed := ScrollYView{
                width: Fill height: Fill flow: Down spacing: 8 scroll_bars +: {auto_tail: true}
                for m in msgs {
                    let role = m.role ?? "say"
                    if role == "you" {
                        MsgCard{
                            draw_bg.color: #x162235
                            who.text: (m.label ?? "You") + "  " + (m.ts ?? "")
                            who.draw_text.color: #x7fb3ff
                            body.text: m.text ?? ""
                            body.draw_text.text_style.font_size: 15
                            body.draw_text.color: #xd6e2f0
                        }
                    } else if role == "tool" {
                        MsgCard{
                            draw_bg.color: #x171b24
                            who.text: (m.label ?? "Tool") + "  " + (m.ts ?? "")
                            who.draw_text.color: #x7d8696
                            body.text: m.text ?? ""
                            body.draw_text.text_style.font_size: 13
                            body.draw_text.color: #x9aa4b2
                        }
                    } else {
                        MsgCard{
                            draw_bg.color: #x1c2230
                            who.text: (m.label ?? "Reply") + "  " + (m.ts ?? "")
                            who.draw_text.color: #x3ddc84
                            body.text: m.text ?? ""
                        }
                    }
                }
                if act != "" {
                    MsgCard{
                        draw_bg.color: #x262116
                        who.text: "Working"
                        who.draw_text.color: #xf5b942
                        body.text: act
                        body.draw_text.text_style.font_size: 14
                        body.draw_text.color: #xf5d98a
                    }
                }
            }
        }
        View{
            width: Fill height: Fit flow: Right spacing: 8
            Big{width: Fill height: 48 text: "Refresh" on_click: || emit("refresh", {})}
            Big{width: Fill height: 48 text: if c != nil && (c.tools ?? false) { "Tools: on" } else { "Tools: off" } on_click: || emit("toggle_tools", {})}
        }
    }
}
