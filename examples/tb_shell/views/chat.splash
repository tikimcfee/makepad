// CHAT: virtualized GPU Markdown conversation view for the selected agent (`state.chat`).
// Uses native `PortalList`-backed `ChatFeed` (`O(viewport)` scrolling, one recycled row per
// Markdown block, rows keyed by event id so updates never shift them, plain-prose `Label` fast
// path + rich `Markdown`, zero Splash `msgs` JSON copy).
width: Fill height: Fill flow: Down padding: 0 spacing: 0
main := View{
    width: Fill height: Fill flow: Down
    on_render: || {
        let cur_l = sa_left()
        let cur_r = sa_right()
        let cur_b = sa_bottom()
        let is_compact = (slot.mode ?? "full") == "compact"
        let pad_b = if is_compact { 12.0 } else { sa_pad(12.0, cur_b) }
        let c = state.chat ?? nil
        let target_name = agent_name(state.agents ?? nil, state.target ?? nil)
        let st = if c == nil { "" } else { c.status ?? "" }
        let act = if c == nil { "" } else { c.activity ?? "" }

        View{
            width: Fill height: Fill flow: Down
            padding: Inset{left: sa_pad(12.0, cur_l) right: sa_pad(12.0, cur_r) top: 12.0 bottom: pad_b}
            spacing: 8

        View{
            width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            Dot{draw_bg.color: status_color(st)}
            ButtonFlat{
                width: Fit height: 34 margin: 0
                padding: Inset{left: 10 right: 10 top: 0 bottom: 0}
                draw_bg.color: #x182232 draw_bg.color_focus: #x182232 draw_bg.color_hover: #x223047
                draw_text.text_style.font_size: 15
                text: (if c == nil { target_name } else { c.agent ?? target_name }) + " v"
                on_click: || front("agents")
            }
            View{width: Fill height: 1}
            Small{text: st}
        }

        feed := ChatFeed{
            width: Fill height: Fill
            store_key: "chat"
            empty_text: "No messages yet."
            on_more: || emit("more", {})
            on_all: || emit("all", {})
        }

        if act != "" {
            Small{width: Fill max_lines: 1 text_overflow: Ellipsis text: act draw_text.color: #xf5b942}
        }

        View{
            width: Fill height: Fit flow: Right spacing: 8
            Big{height: 44 text: "Refresh" on_click: || emit("refresh", {})}
            Big{
                height: 44
                text: if (if c == nil { false } else { c.tools ?? false }) { "Tools: on" } else { "Tools: off" }
                on_click: || emit("toggle_tools", {})
            }
        }
        }
    }
}
