// HOME: 5x2 core grid (`Agents`, `Voice`, `Chat`, `Terminal`, `Battery`, `Sound`, `Display`,
// `Wi-Fi`, `Stage`, `+ Shell`), quick `Power` button, saved `state.workspaces`, and live/saved
// agent surfaces with one-tap `[+]` stack-add and `[x]` close.
let CoreTile = Squircle{
    width: Fill height: 82 flow: Down spacing: 3
    padding: Inset{left: 14 right: 14 top: 8 bottom: 8}
    align: Align{x: 0.0 y: 0.5}
    draw_bg.border_radius: 16.0
    t := Title{draw_text.text_style.font_size: 16.5}
    s := Small{width: Fill draw_text.text_style.font_size: 12 max_lines: 1 text_overflow: Ellipsis}
}
let SurfCard = RoundedView{
    width: Fill height: 56 flow: Right spacing: 8
    padding: Inset{left: 14 right: 10} align: Align{y: 0.5}
    show_bg: true
    draw_bg.color: #x1c2230 draw_bg.border_radius: 14.0
}
fn count_agent_surfaces(list) {
    let mut n = 0
    for s in list ?? [] {
        if (s.kind ?? "") == "agent" { n = n + 1 }
    }
    n
}
width: Fill height: Fill flow: Down padding: 0
main := View{
    width: Fill height: Fill flow: Down
    on_render: || {
        let cur_l = sa_left()
        let cur_r = sa_right()
        let cur_b = sa_bottom()
        let b = state.battery ?? nil
        let v = state.voice ?? nil
        let c = state.chat ?? nil
        let snd = state.sound ?? nil
        let d = state.display ?? nil
        let w = state.wifi ?? nil
        let td = state.termd ?? nil
        let term_n = if td == nil { 0 } else { td.count ?? 0 }
        let stg = state.stage ?? nil
        let slots_n = if stg == nil { 1 } else { (stg.slots ?? []).len() }
        let surfs = state.surfaces ?? []
        let wks = state.workspaces ?? []

        View{
            width: Fill height: Fill
            padding: Inset{left: cur_l right: cur_r top: 0.0 bottom: cur_b}
            ScrollYView{
                width: Fill height: Fill flow: Down
                padding: Inset{left: sa_inner(12.0, cur_l) right: sa_inner(12.0, cur_r) top: 12.0 bottom: sa_inner(12.0, cur_b)}
                spacing: 9

        View{
            width: Fill height: Fit flow: Right spacing: 9
            on_item_tap: |col| { if col == 0 { front("agents") } else { front("voice") } }
            CoreTile{t.text: "Agents" s.text: agent_name(state.agents ?? nil, state.target ?? nil)}
            CoreTile{t.text: "Voice" s.text: if v == nil || (v.text ?? "") == "" { "ready" } else { v.text ?? "ready" }}
        }
        View{
            width: Fill height: Fit flow: Right spacing: 9
            on_item_tap: |col| { if col == 0 { front("chat") } else { front("terminal") } }
            CoreTile{t.text: "Chat" s.text: if c == nil || (c.preview ?? "") == "" { "no replies yet" } else { c.preview ?? "" }}
            CoreTile{t.text: "Terminal" s.text: "" + term_n + (if term_n == 1 { " live session" } else { " live sessions" })}
        }
        View{
            width: Fill height: Fit flow: Right spacing: 9
            on_item_tap: |col| { if col == 0 { front("battery") } else { front("sound") } }
            CoreTile{t.text: "Battery" s.text: if b == nil { "reading..." } else { show(b.pct ?? nil, "%") + " · " + (b.state ?? "") }}
            CoreTile{t.text: "Sound" s.text: if snd == nil { "reading..." } else { show(snd.volume_db ?? nil, " dB") + " · " + (snd.speaker_state ?? "") }}
        }
        View{
            width: Fill height: Fit flow: Right spacing: 9
            on_item_tap: |col| { if col == 0 { front("display") } else { front("wifi") } }
            CoreTile{t.text: "Display" s.text: if d == nil { "reading..." } else { show(d.brightness ?? nil, "") + "/" + show(d.max ?? 255, "") + " · " + (d.panel ?? "on") }}
            CoreTile{t.text: "Wi-Fi" s.text: if w == nil { "reading..." } else { (w.state ?? "off") + (if (w.ipv4 ?? nil) == nil { "" } else { " · " + w.ipv4 }) }}
        }
        View{
            width: Fill height: Fit flow: Right spacing: 9
            on_item_tap: |col| { if col == 0 { front("stage") } else { emit("termd_create", {ns: "default", focus: true}) } }
            CoreTile{t.text: "Stage" s.text: "" + slots_n + (if slots_n == 1 { " active slot" } else { " active slots" })}
            CoreTile{t.text: "+ New Shell" s.text: "start local terminal"}
        }

        if wks.len() > 0 {
            Small{text: "Workspaces"}
            for wk in wks {
                let wname = wk.name ?? ""
                SurfCard{
                    ButtonFlat{
                        width: Fill height: 42 margin: 0 text: wk.title ?? wname
                        draw_bg.color: #x00000000 draw_bg.color_focus: #x00000000 draw_bg.color_hover: #x252e40
                        draw_text.text_style.font_size: 15
                        on_click: || stage({sub: "open", name: wname})
                    }
                    MiniBtn{text: "x" on_click: || stage({sub: "unsave", name: wname})}
                }
            }
        }

        if count_agent_surfaces(surfs) > 0 {
            Small{text: "Surfaces"}
            for s in surfs {
                if (s.kind ?? "") == "agent" {
                    let sname = s.name ?? ""
                    SurfCard{
                        ButtonFlat{
                            width: Fill height: 42 margin: 0
                            text: (s.title ?? sname) + (if s.saved ?? false { "  · saved" } else { "" })
                            draw_bg.color: #x00000000 draw_bg.color_focus: #x00000000 draw_bg.color_hover: #x252e40
                            draw_text.text_style.font_size: 15
                            on_click: || front(sname)
                        }
                        MiniBtn{text: "+" on_click: || stage({sub: "add", surface: sname})}
                    }
                }
            }
        }

        View{
            width: Fill height: Fit flow: Right spacing: 8
            PillBtn{width: Fill height: 42 text: "Voice + Chat split" on_click: || stage({sub: "stack", specs: ["voice:compact:pin", "chat"]})}
            ButtonFlat{
                width: 96 height: 42 margin: 0 text: "Power"
                draw_bg.color: #x3a1d24 draw_bg.color_focus: #x3a1d24 draw_bg.color_hover: #x4d2630
                draw_text.text_style.font_size: 13.5
                on_click: || front("power")
            }
        }
            }
        }
    }
}
