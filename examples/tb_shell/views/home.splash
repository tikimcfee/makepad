// HOME: the six core system tiles in a 2-column grid, plus any live or saved agent
// surfaces from `state.surfaces` below them. Tapping the top strip always returns here.
let CoreTile = Squircle{
    width: Fill height: 92 flow: Down spacing: 4
    padding: Inset{left: 14 right: 14 top: 8 bottom: 8}
    align: Align{x: 0.0 y: 0.5}
    t := Title{draw_text.text_style.font_size: 17}
    s := Small{width: Fill draw_text.text_style.font_size: 12 max_lines: 1 text_overflow: Ellipsis}
}
let AgentRow = Squircle{
    width: Fill height: 64 flow: Right spacing: 10
    padding: Inset{left: 16 right: 16}
    align: Align{y: 0.5}
    t := Title{width: Fill draw_text.text_style.font_size: 16}
    tag := Small{}
}
fn count_agent_surfaces(list) {
    let mut n = 0
    for s in list ?? [] {
        if (s.kind ?? "") == "agent" { n = n + 1 }
    }
    n
}
fn nth_agent_surface(list, idx) {
    let mut k = 0
    for s in list ?? [] {
        if (s.kind ?? "") == "agent" {
            if k == idx { return s.name ?? "" }
            k = k + 1
        }
    }
    ""
}
width: Fill height: Fill flow: Down padding: 14
main := ScrollYView{
    width: Fill height: Fill flow: Down spacing: 10
    on_render: || {
        let b = state.battery ?? nil
        let v = state.voice ?? nil
        let c = state.chat ?? nil
        let snd = state.sound ?? nil
        let d = state.display ?? nil
        let surfs = state.surfaces ?? []

        View{
            width: Fill height: Fit flow: Right spacing: 10
            on_item_tap: |col| { if col == 0 { front("agents") } else { front("voice") } }
            CoreTile{t.text: "Agents" s.text: agent_name(state.agents ?? nil, state.target ?? nil)}
            CoreTile{t.text: "Voice" s.text: if v == nil { "quiet" } else { v.text ?? "quiet" }}
        }
        View{
            width: Fill height: Fit flow: Right spacing: 10
            on_item_tap: |col| { if col == 0 { front("chat") } else { front("battery") } }
            CoreTile{t.text: "Chat" s.text: if c == nil { "no replies yet" } else { c.preview ?? "no replies yet" }}
            CoreTile{t.text: "Battery" s.text: if b == nil { "no reading" } else { show(b.pct ?? nil, "%") + "  " + (b.state ?? "") }}
        }
        View{
            width: Fill height: Fit flow: Right spacing: 10
            on_item_tap: |col| { if col == 0 { front("sound") } else { front("display") } }
            CoreTile{t.text: "Sound" s.text: if snd == nil { "no reading" } else { show(snd.volume_db ?? nil, " dB") + " · " + (snd.speaker_state ?? "") }}
            CoreTile{t.text: "Display" s.text: if d == nil { "no reading" } else { show(d.brightness ?? nil, "") + "/" + show(d.max ?? 255, "") + " · " + (d.panel ?? "?") }}
        }

        if count_agent_surfaces(surfs) > 0 {
            Small{text: "Surfaces"}
            View{
                width: Fill height: Fit flow: Down spacing: 8
                on_item_tap: |i| {
                    let target = nth_agent_surface(state.surfaces ?? [], i)
                    if target != "" { front(target) }
                }
                for s in surfs {
                    if (s.kind ?? "") == "agent" {
                        AgentRow{
                            t.text: s.title ?? s.name ?? ""
                            tag.text: if s.saved ?? false { "saved" } else { "live" }
                        }
                    }
                }
            }
        }
    }
}
