// AGENTS: pick default target (`state.target`) or jump straight to its `Chat`.
// `compact` mode renders a horizontal scrollable pill strip; `full` mode renders
// collapsible device sections sorted by name (all expanded by default, state
// persisted in `state.agents_collapsed`).
let SectionHdr = RoundedView{
    width: Fill height: 44 flow: Right spacing: 8
    padding: Inset{left: 12 right: 12} align: Align{y: 0.5}
    show_bg: true
    draw_bg.color: #x151b26 draw_bg.border_radius: 12.0
}
let AgentCard = RoundedView{
    width: Fill height: Fit flow: Down spacing: 8
    padding: Inset{left: 12 right: 12 top: 10 bottom: 10}
    show_bg: true
    draw_bg.color: #x1c2230 draw_bg.border_radius: 14.0
}
fn agent_host_name(a) {
    let h = a.host ?? ""
    if h != "" { return "" + h }
    let parts = ("" + (a.id ?? "")).split("@")
    if parts.len() > 1 && parts[1] != "" { return parts[1] }
    "local"
}
fn has_str(list, target) {
    for x in list ?? [] {
        if x == target { return true }
    }
    false
}
fn has_local_agent_term(terms, aname, asess) {
    let want1 = "agent-" + aname
    for t in terms ?? [] {
        if (t.ns ?? "") == "agents" {
            let tid = t.id ?? ""
            if tid == want1 || (asess != "" && tid == asess) { return true }
        }
    }
    false
}
fn toggle_host(collapsed, host) {
    let mut next = []
    let mut found = false
    for h in collapsed ?? [] {
        if h == host {
            found = true
        } else {
            next.push(h)
        }
    }
    if !found { next.push(host) }
    next
}
fn sort_key(item, by_agent) {
    if by_agent {
        return ("" + (item.name ?? (item.id ?? ""))).to_lower()
    }
    ("" + item).to_lower()
}
fn sort_items(list, by_agent) {
    let mut out = []
    for x in list { out.push(x) }
    let n = out.len()
    for i in 0..n {
        let mut min_i = i
        let mut j = i + 1
        loop {
            if j >= n { break }
            if sort_key(out[j], by_agent) < sort_key(out[min_i], by_agent) {
                min_i = j
            }
            j = j + 1
        }
        if min_i != i {
            let tmp = out[i]
            out[i] = out[min_i]
            out[min_i] = tmp
        }
    }
    out
}
width: Fill height: Fit flow: Down
main := View{
    width: Fill height: Fit flow: Down
    on_render: || {
        let is_compact = (slot.mode ?? "full") == "compact"
        let raw_list = state.agents ?? []
        let list = sort_items(raw_list, true)
        let cur_target = state.target ?? nil
        let cur_l = sa_left()
        let cur_r = sa_right()
        let cur_b = sa_bottom()

        if is_compact {
            compact_bar := View{
                width: Fill height: 58 padding: Inset{left: sa_pad(10.0, cur_l) right: sa_pad(10.0, cur_r) top: 8.0 bottom: 8.0}
                ScrollXView{
                    width: Fill height: 42 flow: Right spacing: 8 align: Align{y: 0.5}
                    for a in list {
                        let aid = a.id ?? ""
                        let sel = aid == cur_target
                        ButtonFlat{
                            width: Fit height: 38 margin: 0
                            padding: Inset{left: 12 right: 12 top: 0 bottom: 0}
                            draw_bg.color: if sel { #x284772 } else { #x1c2230 }
                            draw_bg.color_focus: if sel { #x284772 } else { #x1c2230 }
                            draw_bg.color_hover: #x2d5080
                            draw_text.text_style.font_size: 13.5
                            text: (a.name ?? aid) + " (" + (a.status ?? "?") + ")"
                            on_click: || set("target", aid)
                        }
                    }
                }
            }
        } else {
            let td = state.termd ?? nil
            let terms = if td == nil { [] } else { td.terminals ?? [] }
            let term_count = if td == nil { 0 } else { td.count ?? 0 }
            let local_host = if td == nil { "local" } else { td.local_host ?? "local" }
            let collapsed = state.agents_collapsed ?? []
            let mut raw_hosts = []
            for a in list {
                let h = agent_host_name(a)
                if !has_str(raw_hosts, h) {
                    raw_hosts.push(h)
                }
            }
            let hosts = sort_items(raw_hosts, false)
            let pad_l = sa_pad(14.0, cur_l)
            let pad_r = sa_pad(14.0, cur_r)
            let pad_b = if (slot.mode ?? "full") == "grid" { 14.0 } else { sa_pad(14.0, cur_b) }
            let list_h = ((slot.height ?? 780.0) - (88.0 + pad_b))
            let safe_h = if list_h < 120.0 { 120.0 } else { list_h }
            full_box := View{
                width: Fill height: Fit flow: Down padding: Inset{left: pad_l right: pad_r top: 14.0 bottom: pad_b} spacing: 9
                // Initiator bar: +Shell, +agy, +claude, Terms (N)
                View{
                    width: Fill height: 36 flow: Right spacing: 5
                    on_item_tap: |col| {
                        if col == 0 { emit("termd_create", {ns: "default", focus: true}) }
                        if col == 1 { emit("termd_spawn_agent", {backend: "agy"}) }
                        if col == 2 { emit("termd_spawn_agent", {backend: "claude"}) }
                        if col == 3 { front("terminal") }
                    }
                    RoundedView{
                        width: Fit height: 36 align: Align{x: 0.5 y: 0.5}
                        padding: Inset{left: 9 right: 9} show_bg: true
                        draw_bg.color: #x1e3a5f draw_bg.border_radius: 10.0
                        Label{draw_text.text_style.font_size: 12.5 draw_text.color: #x93c5fd text: "+Shell"}
                    }
                    RoundedView{
                        width: Fit height: 36 align: Align{x: 0.5 y: 0.5}
                        padding: Inset{left: 9 right: 9} show_bg: true
                        draw_bg.color: #x1e293b draw_bg.border_radius: 10.0
                        Label{draw_text.text_style.font_size: 12.5 draw_text.color: #xe2e8f0 text: "+agy"}
                    }
                    RoundedView{
                        width: Fit height: 36 align: Align{x: 0.5 y: 0.5}
                        padding: Inset{left: 9 right: 9} show_bg: true
                        draw_bg.color: #x1e293b draw_bg.border_radius: 10.0
                        Label{draw_text.text_style.font_size: 12.5 draw_text.color: #xe2e8f0 text: "+claude"}
                    }
                    RoundedView{
                        width: Fill height: 36 align: Align{x: 0.5 y: 0.5}
                        padding: Inset{left: 6 right: 6} show_bg: true
                        draw_bg.color: #x182232 draw_bg.border_radius: 10.0
                        Label{
                            max_lines: 1 text_overflow: Ellipsis
                            draw_text.text_style.font_size: 12.0
                            draw_text.color: #x93c5fd
                            text: "Terms (" + show(term_count, ")")
                        }
                    }
                }
                Small{text: "Agents · tap device to fold, Term to open session"}
                ScrollYView{
                    width: Fill height: safe_h flow: Down spacing: 8
                    if hosts.len() == 0 {
                        Small{text: "No agents online"}
                    }
                    for h in hosts {
                        let host_name = h
                        let is_col = has_str(collapsed, host_name)
                        let mut total_n = 0
                        let mut busy_n = 0
                        let mut wait_n = 0
                        let mut has_sel = false
                        for a in list {
                            if agent_host_name(a) == host_name {
                                total_n = total_n + 1
                                let st = a.status ?? ""
                                if st == "busy" || st == "processing" { busy_n = busy_n + 1 }
                                if st == "waiting" { wait_n = wait_n + 1 }
                                if (a.id ?? "") == cur_target { has_sel = true }
                            }
                        }
                        let count_txt = "" + total_n + (if wait_n > 0 { " · " + wait_n + " waiting" } else { "" }) + (if busy_n > 0 { " · " + busy_n + " busy" } else { "" })
                        View{
                            width: Fill height: Fit flow: Down spacing: 6
                            View{
                                width: Fill height: Fit
                                on_item_tap: |i| set("agents_collapsed", toggle_host(state.agents_collapsed ?? [], host_name))
                                SectionHdr{
                                    draw_bg.color: if wait_n > 0 { #x241936 } else { if is_col && has_sel { #x19283d } else { #x151b26 } }
                                    Small{
                                        text: if is_col { ">" } else { "v" }
                                        draw_text.color: #x9aa4b2
                                    }
                                    Title{
                                        width: Fill
                                        draw_text.text_style.font_size: 15
                                        draw_text.color: #xe2e8f0
                                        text: host_name
                                    }
                                    if is_col && has_sel {
                                        sel_dot := Dot{width: 8 height: 8 draw_bg.border_radius: 4.0 draw_bg.color: #x60a5fa}
                                    }
                                    cnt_lbl := Small{
                                        text: count_txt
                                        draw_text.color: if wait_n > 0 { #xd8b4fe } else { #x8b95a5 }
                                    }
                                }
                            }
                            if !is_col {
                                for a in list {
                                    if agent_host_name(a) == host_name {
                                        let aid = a.id ?? ""
                                        let aname = a.name ?? aid
                                        let asess = a.session ?? ""
                                        let ast = a.status ?? ""
                                        let adetail = a.detail ?? ""
                                        let is_wait = ast == "waiting"
                                        let sel = aid == cur_target
                                        let is_local = host_name == local_host || host_name == "local"
                                        let native_local = is_local && has_local_agent_term(terms, aname, asess)
                                        let bid = bus_term_id(aid)
                                        let aback = a.backend ?? ""
                                        let sub_txt = if is_wait && adetail != "" { adetail } else if aback != "" && ast != "" { aback + " · " + ast } else if aback != "" { aback } else { ast }
                                        let sub_col = if is_wait && adetail != "" { #xd8b4fe } else { #x9aa4b2 }
                                        AgentCard{
                                            draw_bg.color: if is_wait { #x261a38 } else { if sel { #x1f314a } else { #x1c2230 } }
                                            View{
                                                width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                                                on_item_tap: |i| set("target", aid)
                                                Dot{draw_bg.color: status_color(ast)}
                                                View{
                                                    width: Fill height: Fit flow: Down spacing: 2
                                                    name_lbl := Label{
                                                        width: Fill
                                                        draw_text.text_style.font_size: 15.5
                                                        draw_text.color: #xeeeeee
                                                        text: aname
                                                    }
                                                    sub_lbl := Label{
                                                        width: Fill max_lines: 1 text_overflow: Ellipsis
                                                        draw_text.text_style.font_size: 12.0
                                                        draw_text.color: sub_col
                                                        text: sub_txt
                                                    }
                                                }
                                            }
                                            View{
                                                width: Fill height: 34 flow: Right spacing: 8
                                                on_item_tap: |col| {
                                                    if col == 0 {
                                                        if native_local {
                                                            emit("termd_focus_agent", {name: aname, session: asess})
                                                        } else if bid != "" {
                                                            emit("termd_create", {
                                                                ns: "default",
                                                                id: bid,
                                                                cmd: "exec /usr/local/bin/tb-agent-term " + aid + " " + bid,
                                                                focus: true,
                                                            })
                                                        }
                                                    }
                                                    if col == 1 {
                                                        set("target", aid)
                                                        front("chat")
                                                    }
                                                }
                                                term_pill := RoundedView{
                                                    width: Fill height: 34 align: Align{x: 0.5 y: 0.5}
                                                    show_bg: true
                                                    draw_bg.color: if is_wait { #x581c87 } else { #x1c3147 }
                                                    draw_bg.border_radius: 10.0
                                                    Label{
                                                        draw_text.text_style.font_size: 13.0
                                                        draw_text.color: if is_wait { #xf3e8ff } else { #x93c5fd }
                                                        text: if is_wait { "Prompt" } else { "Term" }
                                                    }
                                                }
                                                chat_pill := RoundedView{
                                                    width: Fill height: 34 align: Align{x: 0.5 y: 0.5}
                                                    show_bg: true
                                                    draw_bg.color: #x222c3e draw_bg.border_radius: 10.0
                                                    Label{
                                                        draw_text.text_style.font_size: 13.0
                                                        draw_text.color: #xeeeeee
                                                        text: "Chat"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
