// POWER: opened by 1.0 s KEY_POWER hold or Home -> Power.
// Uses a plain inline 2-tap UI confirmation for Restart and Power off.
width: Fill height: Fill flow: Down padding: 0 spacing: 0 align: Align{y: 0.5}
main := View{
    width: Fill height: Fit flow: Down
    on_render: || {
        let cur_l = sa_left()
        let cur_r = sa_right()
        let cur_b = sa_bottom()
        View{
            width: Fill height: Fit flow: Down
            padding: Inset{left: sa_pad(20.0, cur_l) right: sa_pad(20.0, cur_r) top: 20.0 bottom: sa_pad(20.0, cur_b)}
            spacing: 12
        let pending = state.power_confirm ?? ""
        Title{draw_text.text_style.font_size: 22 text: "Power"}

        if pending == "reboot" {
            Small{text: "Restart Tinybot now?" draw_text.color: #xf5b942}
            Big{
                height: 62 text: "Confirm Restart"
                draw_bg.color: #x7a5118 draw_bg.color_focus: #x7a5118 draw_bg.color_hover: #x94631e
                on_click: || {
                    set("power_confirm", "")
                    emit("reboot", {})
                }
            }
            Big{
                height: 54 text: "Cancel"
                on_click: || set("power_confirm", "")
            }
        } else if pending == "poweroff" {
            Small{text: "Power off Tinybot now?" draw_text.color: #xff6b6b}
            Big{
                height: 62 text: "Confirm Power off"
                draw_bg.color: #x7d1e28 draw_bg.color_focus: #x7d1e28 draw_bg.color_hover: #x992532
                on_click: || {
                    set("power_confirm", "")
                    emit("poweroff", {})
                }
            }
            Big{
                height: 54 text: "Cancel"
                on_click: || set("power_confirm", "")
            }
        } else {
            Small{text: "Screen sleep, restart, or shut down"}
            Big{
                height: 60 text: "Screen off"
                draw_bg.color: #x1e2738 draw_bg.color_focus: #x1e2738 draw_bg.color_hover: #x27334a
                on_click: || {
                    set("power_confirm", "")
                    front("home")
                    emit("screen_off", {})
                }
            }
            Big{
                height: 60 text: "Restart"
                draw_bg.color: #x4a3519 draw_bg.color_focus: #x4a3519 draw_bg.color_hover: #x5e4420
                on_click: || set("power_confirm", "reboot")
            }
            Big{
                height: 60 text: "Power off"
                draw_bg.color: #x631e27 draw_bg.color_focus: #x631e27 draw_bg.color_hover: #x7a2530
                on_click: || set("power_confirm", "poweroff")
            }
            Big{
                height: 52 text: "Cancel"
                on_click: || {
                    set("power_confirm", "")
                    front("home")
                }
            }
        }
        }
    }
}
