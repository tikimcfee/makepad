# An example of the app's user unit; the paths are the image's to choose.
# Type=notify: the app sends READY=1 once its socket is bound and its first frame is drawn,
# so what is ordered after this unit starts when the surface can be used.
[Unit]
Description=tinybot live surface
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/opt/tinybot/surface/makepad-example-tinybot-surface
# Linked shader programs are kept on disk for the next start. Here: in a cache directory
# of the app's own (~/.cache/tinybot-surface), not the one all Makepad apps of the user share.
CacheDirectory=tinybot-surface
Environment=MAKEPAD_HAL_CACHE_DIR=%C/tinybot-surface
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
